<div class="rk-page-heading">
  <div><p class="rk-kicker"><%= link_to @resource.title, records_path(slug: params[:slug]) %> / Record</p><h1><%= @model.model_name.human %> #<%= @record.to_param %></h1></div>
  <div class="rk-actions">
    <% if allowed?(@record, :edit?) %><%= link_to "Edit", edit_record_path(slug: params[:slug], id: @record.to_param), class: "rk-button rk-button--secondary" %><% end %>
    <% if allowed?(@record, :destroy?) %>
      <%= button_to "Delete", record_path(slug: params[:slug], id: @record.to_param), method: :delete, form: { data: { turbo: false } }, class: "rk-button rk-button--secondary" %>
    <% end %>
  </div>
</div>
<section class="rk-panel">
  <dl class="rk-details">
    <% @resource.show.fields.each do |field| %>
      <div><dt><%= field.label %></dt><dd><%= rekorra_field_value(@record, field) %></dd></div>
    <% end %>
  </dl>
</section>
<% if @context_entries.any? %>
  <section class="rk-panel rk-context" aria-labelledby="rk-context-heading">
    <h2 id="rk-context-heading">Linked context</h2>
    <ul class="rk-context__list">
      <% @context_entries.each do |entry| %>
        <li>
          <% if entry.resource_slug %>
            <%= link_to entry.label, record_path(slug: entry.resource_slug, id: entry.record_id), class: "rk-context__link" %>
          <% else %>
            <span class="rk-context__label"><%= entry.label %></span>
          <% end %>
          <span class="rk-muted"><%= entry.reference.is_a?(Rekorra::ContextRef) ? "Internal" : "External reference" %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
<% if @external_links.any? %>
  <section class="rk-panel rk-external-links" aria-labelledby="rk-external-links-heading">
    <h2 id="rk-external-links-heading">External tools</h2>
    <ul class="rk-external-links__list">
      <% @external_links.each do |external_link| %>
        <li>
          <%= link_to external_link.label, external_link.url, target: "_blank",
            rel: "noopener noreferrer", referrerpolicy: "no-referrer",
            class: "rk-external-link" %>
          <span class="rk-muted"><%= external_link.provider.to_s.humanize %> · Opens in new tab</span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
<% @related.each do |name, records| %>
  <section class="rk-panel rk-related">
    <h2><%= name.to_s.humanize %></h2>
    <% if records.empty? %><p class="rk-muted">No visible related records.</p><% end %>
    <ul class="rk-related-list">
      <% records.each do |record| %>
        <li>
          <% slug = Rekorra.slug_for(record.class) %>
          <% label = record.respond_to?(:number) ? record.number : "##{record.to_param}" %>
          <% if slug %><%= link_to label, record_path(slug: slug, id: record.to_param) %><% else %><%= label %><% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
