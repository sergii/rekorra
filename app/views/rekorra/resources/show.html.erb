<div class="rk-page-heading">
  <div><p class="rk-kicker"><%= link_to @resource.title, records_path(slug: params[:slug]) %> / Record</p><h1><%= @model.model_name.human %> #<%= @record.to_param %></h1></div>
  <div class="rk-actions">
    <% if allowed?(@record, :edit?) %><%= link_to "Edit", edit_record_path(slug: params[:slug], id: @record.to_param), class: "rk-button rk-button--secondary" %><% end %>
    <% if allowed?(@record, :destroy?) %>
      <%= button_to "Delete", record_path(slug: params[:slug], id: @record.to_param), method: :delete, form: { data: { turbo: false } }, class: "rk-button rk-button--secondary" %>
    <% end %>
  </div>
</div>
<section class="rk-panel">
  <dl class="rk-details">
    <% @show_fields.each do |field| %>
      <div><dt><%= field.label %></dt><dd><%= rekorra_field_value(@record, field) %></dd></div>
    <% end %>
  </dl>
</section>
<% if @findings_visible %>
  <section class="rk-panel rk-findings" aria-labelledby="rk-findings-heading">
    <h2 id="rk-findings-heading">Findings</h2>
    <% if @finding_items.empty? %>
      <p class="rk-muted">No active findings.</p>
    <% else %>
      <ul class="rk-findings__list">
        <% @finding_items.each do |finding| %>
          <li class="rk-findings__item">
            <div class="rk-findings__title">
              <strong><%= finding.title %></strong>
              <span class="rk-badge"><%= finding.severity.humanize %></span>
            </div>
            <p class="rk-muted"><%= finding.description %></p>
            <dl class="rk-findings__evidence">
              <% finding.evidence.each do |item| %>
                <div><dt><%= item.label %></dt><dd><%= item.value %></dd></div>
              <% end %>
            </dl>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
<% if @jobs_visible %>
  <section class="rk-panel rk-jobs" aria-labelledby="rk-jobs-heading">
    <h2 id="rk-jobs-heading">Background Jobs</h2>
    <% if @job_items.empty? %>
      <p class="rk-muted">No linked jobs.</p>
    <% else %>
      <ul class="rk-jobs__list">
        <% @job_items.each do |item| %>
          <li class="rk-jobs__item">
            <div class="rk-jobs__title">
              <strong><%= item.name %></strong>
              <span class="rk-badge"><%= item.status.humanize %></span>
            </div>
            <dl class="rk-jobs__detail">
              <div><dt>Job ID</dt><dd><%= item.id %></dd></div>
              <div><dt>Queue</dt><dd><%= item.queue %></dd></div>
              <div><dt>Created</dt><dd><%= item.created_at ? l(item.created_at, format: :long) : "Unknown" %></dd></div>
              <% if item.finished_at %>
                <div><dt>Finished</dt><dd><%= l(item.finished_at, format: :long) %></dd></div>
              <% end %>
            </dl>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
<% end %>
<% if @activity_visible %>
  <section class="rk-panel rk-activity" aria-labelledby="rk-activity-heading">
    <h2 id="rk-activity-heading">Activity</h2>
    <% if @activity_events.empty? %>
      <p class="rk-muted">No recorded changes.</p>
    <% else %>
      <ol class="rk-activity__events">
        <% @activity_events.each do |event| %>
          <li class="rk-activity__event">
            <div class="rk-activity__summary">
              <strong><%= event.kind.humanize %></strong>
              <span><%= event.at ? l(event.at, format: :long) : "Unknown time" %></span>
            </div>
            <div class="rk-muted">By <%= event.actor %></div>
            <% if event.changes.any? %>
              <dl class="rk-activity__changes">
                <% event.changes.each do |change| %>
                  <div>
                    <dt><%= change.field.humanize %></dt>
                    <dd><span><%= change.before %></span><span aria-hidden="true">→</span><span><%= change.after %></span></dd>
                  </div>
                <% end %>
              </dl>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
  </section>
<% end %>
<% if @context_entries.any? %>
  <section class="rk-panel rk-context" aria-labelledby="rk-context-heading">
    <h2 id="rk-context-heading">Linked context</h2>
    <ul class="rk-context__list">
      <% @context_entries.each do |entry| %>
        <li>
          <% if entry.resource_slug %>
            <%= link_to entry.label, record_path(slug: entry.resource_slug, id: entry.record_id), class: "rk-context__link" %>
          <% else %>
            <span class="rk-context__label"><%= entry.label %></span>
          <% end %>
          <span class="rk-muted"><%= entry.reference.is_a?(Rekorra::ContextRef) ? "Internal" : "External reference" %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
<% if @external_links.any? %>
  <section class="rk-panel rk-external-links" aria-labelledby="rk-external-links-heading">
    <h2 id="rk-external-links-heading">External tools</h2>
    <ul class="rk-external-links__list">
      <% @external_links.each do |external_link| %>
        <li>
          <%= link_to external_link.label, external_link.url, target: "_blank",
            rel: "noopener noreferrer", referrerpolicy: "no-referrer",
            class: "rk-external-link" %>
          <span class="rk-muted"><%= external_link.provider.to_s.humanize %> · Opens in new tab</span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
<% @related.each do |name, records| %>
  <section class="rk-panel rk-related">
    <h2><%= name.to_s.humanize %></h2>
    <% if records.empty? %><p class="rk-muted">No visible related records.</p><% end %>
    <ul class="rk-related-list">
      <% records.each do |record| %>
        <li>
          <% slug = Rekorra.slug_for(record.class) %>
          <% label = record.respond_to?(:number) ? record.number : "##{record.to_param}" %>
          <% if slug %><%= link_to label, record_path(slug: slug, id: record.to_param) %><% else %><%= label %><% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
