<!DOCTYPE html>
<html lang="en" data-theme="<%= rekorra_theme %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="data:,">
    <title>Rekorra</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Host-owned Importmap/Hotwire integration; no mandatory dependency. %>
    <%= javascript_importmap_tags if Rekorra.configuration.importmap_enabled %>
    <%= stylesheet_link_tag "rekorra/application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "rekorra/index", defer: true %>
    <%= javascript_include_tag "rekorra/associations", defer: true %>
  </head>
  <body class="rk-app">
    <header class="rk-header">
      <div class="rk-shell rk-header__inner">
        <a class="rk-brand" href="<%= root_path %>">Rekorra</a>
        <%= form_with url: theme_path, method: :post, local: true, class: "rk-theme" do |form| %>
          <%= form.label :theme, "Theme" %>
          <%= form.select :theme, [["Auto", "auto"], ["Light", "light"], ["Dark", "dark"]], { selected: rekorra_theme } %>
          <%= form.submit "Apply", class: "rk-button rk-button--secondary" %>
        <% end %>
      </div>
    </header>
    <% navigation = rekorra_navigation %>
    <div class="<%= navigation ? "rk-workspace-shell" : "" %>">
      <% if navigation %>
        <aside class="rk-sidebar">
          <details open>
            <summary>Navigation</summary>
            <nav aria-label="Backoffice resources">
              <%= link_to "Overview", root_path %>
              <%= render "rekorra/shared/navigation_tree", node: navigation %>
            </nav>
          </details>
        </aside>
      <% end %>
      <main class="rk-shell rk-main">
        <% if notice.present? %><p class="rk-notice"><%= notice %></p><% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
